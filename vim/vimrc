set nocompatible

" cmux/Ghostty resets the keyboard protocol on focus/surface changes (e.g. when
" opening a file), which desyncs modifyOtherKeys and broke <C-p> (FZF). vim's
" 'keyprotocol' option doesn't retroactively clear t_TI/t_TE, so clear them
" directly: vim never sends the modifyOtherKeys enable (CSI>4;2m) and Ctrl- keys
" always arrive as stable legacy bytes.
set t_TI= t_TE=

let g:python3_host_prog = expand('/usr/local/bin/python3')

so ~/.vimrc.plugins

" theme
syntax enable
set termguicolors
set background=dark
colorscheme solarized8

filetype plugin indent on     " required!
" preference
set hlsearch
" no tab
set expandtab
set shiftwidth=4
set softtabstop=4
set noshowmatch " show matching brackets
" no wrap
set textwidth=0
set nu
" set rnu // rnu is slow
" menu completion
set wildmode=longest,list
set wildmenu

" list
set list
set listchars=trail:.,tab:>.,extends:>,precedes:<,nbsp:.

" trim whitespace
autocmd BufWritePre * :%s/\s\+$//e

set clipboard=unnamed

" Short Cuts
" Jump Between Errors
" Replace command
nnoremap gr gd[{V%:s/<C-R>///gc<left><left><left>

au BufNewFile,BufRead *.scala setlocal filetype=scala
autocmd BufNewFile,BufRead *.pdsc set filetype=json
autocmd BufNewFile,BufRead *.avsc set filetype=json
autocmd BufNewFile,BufRead *.h setlocal filetype=objc
autocmd BufNewFile,BufRead *.m setlocal filetype=objc
autocmd BufNewFile,BufRead *.mm setlocal filetype=objc
autocmd BufNewFile,BufRead *.entitlements setlocal filetype=xml
autocmd Filetype xml setlocal ts=4 sw=4 noexpandtab

" open quick fix after grep
autocmd QuickFixCmdPost *grep* cwindow

" interesting worlds
let g:brightest#highlight = {"group": "BrightestUnderline"}

imap jk <Esc>
" command! JLint %!python -m json.tool
