#!/bin/sh
CMUX=$(command -v cmux || echo /Applications/cmux.app/Contents/Resources/bin/cmux)

id=$(pbpaste | grep -oE '[0-9]{6,}' | head -1)

if [ -n "$id" ]; then
  open "rdar://$id"
else
  "$CMUX" notify --title "No radar number on the clipboard" >/dev/null 2>&1
fi

# cmux inserts this tab directly after the one that launched it.
prev=$("$CMUX" --id-format both list-pane-surfaces --json 2>/dev/null | /usr/bin/python3 -c '
import json, os, sys

surfaces = json.load(sys.stdin)["surfaces"]
me = os.environ.get("CMUX_SURFACE_ID")
mine = next((s for s in surfaces if s["id"] == me), None)
if mine is None:
    raise SystemExit
target = {s["index"]: s for s in surfaces if s["id"] != me}.get(mine["index"] - 1)
if target:
    print(target["id"])
' 2>/dev/null)

# Closing a surface makes cmux select the adjacent one, so refocus after, detached.
if [ -n "$prev" ]; then
  CMUX_BIN="$CMUX" WS="$CMUX_WORKSPACE_ID" PREV="$prev" nohup sh -c '
    sleep 0.25
    "$CMUX_BIN" rpc surface.focus "{\"workspace_id\":\"$WS\",\"surface_id\":\"$PREV\"}"
  ' >/dev/null 2>&1 &
fi

"$CMUX" close-surface --surface "$CMUX_SURFACE_ID" >/dev/null 2>&1
