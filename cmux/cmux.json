{
  "$schema" : "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "actions" : {
    "radar.openSelection" : {
      "command" : "\"$HOME/.local/bin/cmux-radar-open\"",
      "icon" : {
        "name" : "ladybug",
        "type" : "symbol"
      },
      "keywords" : [
        "radar",
        "rdar"
      ],
      "shortcut" : "cmd+shift+x",
      "subtitle" : "Open the copied radar number in Radar.app",
      "target" : "newTabInCurrentPane",
      "title" : "Open Radar from Selection",
      "type" : "command"
    }
  },
  "app" : {
    "openSupportedFilesInCmux" : false,
    "preferredEditor" : "cmux-open-file",
    "reorderOnNotification" : false
  },
  "customSidebars" : {
    "renderer" : "inProcess"
  },
  "fileExplorer" : {
    "doubleClickAction" : "preferredEditor"
  },
  "remoteTmux" : {
    "beta" : {
      "enabled" : true
    }
  },
  "schemaVersion" : 1,
  "shortcuts" : {
    "bindings" : {
      "commandPaletteNext" : null,
      "commandPalettePrevious" : null,
      "reopenPreviousSession" : null,
      "switchRightSidebarToDock" : null,
      "switchRightSidebarToFeed" : null,
      "switchRightSidebarToFiles" : null,
      "switchRightSidebarToFind" : null,
      "switchRightSidebarToSessions" : null
    }
  },
  "terminal" : {
    "copyOnSelect" : true
  }
}